(assert (== (file-type (arr-get args 3)) file-type-symlink-dir))
(assert (== (file-type (arr-get args 4)) file-type-symlink-dead))
(assert (== (file-type (arr-get args 5)) file-type-symlink-other))
(assert (== (file-type (arr-get args 6)) file-type-does-not-exist))

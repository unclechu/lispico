; Check all symbolic link types using paths generated by tests/run-file-io.sh
(assert (== (file-type (arr-get argv 2)) file-type-file))
(assert (== (file-type (arr-get argv 3)) file-type-dir))
(assert (== (file-type (arr-get argv 4)) file-type-symlink-file))
(assert (== (file-type (arr-get argv 5)) file-type-symlink-dir))
(assert (== (file-type (arr-get argv 6)) file-type-symlink-dead))
(assert (== (file-type (arr-get argv 7)) file-type-symlink-other))
(assert (== (file-type (arr-get argv 8)) file-type-does-not-exist))
